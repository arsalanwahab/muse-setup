#!/usr/bin/env python3
"""pantheon — Muse route CLI.

  pantheon status            route, repair config, credential state
  pantheon on | off          enable/disable the US route
  pantheon setup             install muse, store your key, configure the route
  pantheon heal              re-point the SSH firewall rule at this IP
  pantheon config <url>      load {"route": "..."} JSON from an https URL
  pantheon doctor [--heal]   test the route, optionally heal and retest
"""

from __future__ import annotations

import getpass
import json
import os
import pathlib
import shutil
import subprocess
import sys
import termios
import time
import tty

HOME = pathlib.Path.home()
SETTINGS = HOME / ".config/muse/settings.json"
ROUTE_FILE = HOME / ".config/muse-vpn/proxy-url"
HEAL_FILE = HOME / ".config/muse-vpn/heal.json"
DEFAULT_HOST = "184.197.234.208:8443"
INSTALL_SH = "https://dev.meta.ai/install.sh"


# ------------------------------------------------------------------ storage

def read_json(path: pathlib.Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def write_json(path: pathlib.Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")
    path.chmod(0o600)


def route() -> str | None:
    try:
        value = ROUTE_FILE.read_text().strip()
        return value or None
    except Exception:
        return None


def save_route(url: str) -> None:
    ROUTE_FILE.parent.mkdir(parents=True, exist_ok=True)
    ROUTE_FILE.write_text(url + "\n")
    ROUTE_FILE.chmod(0o600)


def active_proxy() -> str | None:
    return read_json(SETTINGS).get("endpoint_transport", {}).get("proxy")


def set_proxy(url: str | None) -> None:
    data = read_json(SETTINGS)
    data.setdefault("schema_version", 1)
    transport = data.setdefault("endpoint_transport", {})
    if url:
        transport["proxy"] = url
    else:
        transport.pop("proxy", None)
    write_json(SETTINGS, data)


def hide(url: str | None) -> str:
    if not url:
        return "-"
    host = url.split("@")[-1].split("://")[-1]
    return "Pantheon Routes" if host == DEFAULT_HOST else host


def heal_config() -> tuple[str, str] | None:
    data = read_json(HEAL_FILE)
    if data.get("url") and data.get("token"):
        return data["url"], data["token"]
    return None


def muse_bin() -> str:
    return shutil.which("muse") or str(HOME / ".local/bin/muse")


def curl(args: list[str], timeout: int = 25) -> subprocess.CompletedProcess:
    return subprocess.run(["curl", "-sS", "-m", str(timeout), *args], text=True, capture_output=True)


# ------------------------------------------------------------------ commands

def cmd_status() -> int:
    on = active_proxy() is not None
    print(f"route      : {'ON  -> ' + hide(active_proxy()) if on else 'OFF (direct)'}")
    print(f"saved      : {hide(route())}")
    print(f"repair     : {'configured' if heal_config() else 'not configured'}")
    providers = read_json(HOME / ".config/muse/auth.json").get("providers", {})
    print(f"credential : {('present (' + ', '.join(providers) + ')') if providers else 'none — run pantheon setup'}")
    print(f"muse       : {'installed' if pathlib.Path(muse_bin()).exists() else 'missing'}")
    return 0


def cmd_on() -> int:
    url = route()
    if not url:
        print("no route saved; run: pantheon config <url>", file=sys.stderr)
        return 1
    set_proxy(url)
    print(f"route ON -> {hide(url)}")
    return 0


def cmd_off() -> int:
    set_proxy(None)
    print("route OFF (direct)")
    return 0


def heal_route() -> tuple[bool, str]:
    cfg = heal_config()
    if not cfg:
        return False, "no repair config at ~/.config/muse-vpn/heal.json"
    url, token = cfg
    proc = curl(["-X", "POST", url, "-H", "content-type: application/json",
                 "-d", json.dumps({"token": token})], timeout=20)
    if proc.returncode != 0:
        return False, f"repair failed: {proc.stderr.strip()}"
    try:
        cidr = json.loads(proc.stdout or "{}").get("cidr")
    except Exception:
        cidr = None
    return (True, f"repaired for {cidr}") if cidr else (False, "repair failed")


def cmd_heal() -> int:
    ok, message = heal_route()
    print(message, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


def cmd_config(url: str) -> int:
    if not url.startswith("https://"):
        print("config URL must be https", file=sys.stderr)
        return 1
    proc = curl([url], timeout=20)
    if proc.returncode != 0:
        print(f"download failed: {proc.stderr.strip()}", file=sys.stderr)
        return 1
    try:
        new_route = (json.loads(proc.stdout).get("route") or "").strip()
    except Exception:
        new_route = ""
    if not new_route:
        print('config must contain {"route": "http://user:pass@host:port"}', file=sys.stderr)
        return 1
    save_route(new_route)
    if active_proxy() is not None:
        set_proxy(new_route)
    print(f"route updated -> {hide(new_route)}")
    return 0


def install_muse() -> str:
    exe = muse_bin()
    if pathlib.Path(exe).exists():
        return exe
    print("installing muse…")
    subprocess.run(["sh", "-c", f"curl -fsSL {INSTALL_SH} | sh"], check=True)
    return muse_bin()


def verify() -> tuple[bool, str]:
    try:
        proc = subprocess.run(
            [muse_bin(), "exec", "reply with exactly: setup-ok"],
            text=True, capture_output=True, timeout=240,
        )
    except Exception as exc:
        return False, str(exc)
    if "setup-ok" in proc.stdout:
        return True, "ok"
    return False, (proc.stdout + proc.stderr).strip()[-600:]


def cmd_setup() -> int:
    user = input("Proxy username: ").strip()
    password = getpass.getpass("Proxy password: ")
    key = getpass.getpass("Meta API key: ").strip()
    if not (user and password and key):
        print("all three values are required", file=sys.stderr)
        return 1

    exe = install_muse()
    import urllib.parse
    endpoint = (route() or f"http://{DEFAULT_HOST}").split("@")[-1].split("://")[-1]
    proxy = f"http://{urllib.parse.quote(user, safe='')}:{urllib.parse.quote(password, safe='')}@{endpoint}"

    set_proxy(proxy)
    save_route(proxy)

    stored = subprocess.run(
        [exe, "auth", "set", "--provider", "meta", "--api-key-stdin"],
        input=key + "\n", text=True, capture_output=True,
    )
    if stored.returncode != 0:
        print(f"could not store the API key: {stored.stderr.strip()}", file=sys.stderr)
        return 1

    print("verifying…")
    ok, message = verify()
    if not ok and ("timed out" in message.lower() or "transport error" in message.lower()):
        healed, _ = heal_route()
        if healed:
            print("repaired firewall rule, retrying…")
            ok, message = verify()
    if not ok:
        print(f"verification failed:\n{message}", file=sys.stderr)
        return 1
    print("ready — run: muse")
    return 0


def test_route() -> tuple[bool, str]:
    url = active_proxy() or route()
    if not url:
        return False, "no route configured"
    proc = curl(["-x", url, "-o", "/dev/null", "-w", "%{http_code} %{time_total}",
                 "https://api.meta.ai/v1/models"], timeout=20)
    if proc.returncode != 0:
        return False, f"route FAILED ({proc.stderr.strip()})"
    parts = proc.stdout.split()
    code = parts[0] if parts else "000"
    elapsed = parts[1] if len(parts) > 1 else "?"
    ok = code in ("200", "401", "403")
    note = " (credential missing or rejected)" if code in ("401", "403") else ""
    return ok, f"route {'OK' if ok else 'FAILED'} (HTTP {code}, {elapsed}s){note}"


def cmd_doctor(heal: bool) -> int:
    ok, message = test_route()
    print(message)
    if ok or not heal:
        return 0 if ok else 1
    print("trying repair…")
    if cmd_heal() != 0:
        return 1
    ok, message = test_route()
    print(message)
    return 0 if ok else 1




# ------------------------------------------------------------------ ui

class C:
    reset = "\x1b[0m"
    bold = "\x1b[1m"
    dim = "\x1b[2m"
    hide = "\x1b[?25l"
    show = "\x1b[?25h"
    clear = "\x1b[2J\x1b[H"
    up = "\x1b[A"
    primary = "\x1b[38;2;255;80;24m"
    secondary = "\x1b[38;2;255;159;28m"
    muted = "\x1b[38;2;140;140;145m"
    success = "\x1b[38;2;65;195;70m"
    error = "\x1b[38;2;255;59;48m"
    info = "\x1b[38;2;33;150;243m"


LOGO = f"""{C.primary}{C.bold}
  ██████╗  █████╗ ███╗   ██╗████████╗██╗  ██╗███████╗ ██████╗ ███╗   ██╗
  ██╔══██╗██╔══██╗████╗  ██║╚══██╔══╝██║  ██║██╔════╝██╔═══██╗████╗  ██║
  ██████╔╝███████║██╔██╗ ██║   ██║   ███████║█████╗  ██║   ██║██╔██╗ ██║
  ██╔═══╝ ██╔══██║██║╚██╗██║   ██║   ██╔══██║██╔══╝  ██║   ██║██║╚██╗██║
  ██║     ██║  ██║██║ ╚████║   ██║   ██║  ██║███████╗╚██████╔╝██║ ╚████║
  ╚═╝     ╚═╝  ╚═╝╚═╝  ╚═══╝   ╚═╝   ╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═══╝{C.reset}
{C.muted}  Muse Code · route control{C.reset}
"""


def is_tty() -> bool:
    return sys.stdin.isatty() and sys.stdout.isatty()


def dot(ok: bool) -> str:
    return f"{C.success}●{C.reset} " if ok else f"{C.error}●{C.reset} "


def header() -> None:
    on = active_proxy() is not None
    providers = read_json(HOME / ".config/muse/auth.json").get("providers", {})
    print(LOGO)
    print(f"  {C.bold}Route{C.reset}       {dot(on)}{C.bold}{'ON' if on else 'OFF'}{C.reset}"
          f"  {C.muted}{hide(active_proxy()) if on else 'direct'}{C.reset}")
    print(f"  {C.bold}Repair{C.reset}      {dot(heal_config() is not None)}"
          f"{C.muted}{'configured' if heal_config() else 'not configured'}{C.reset}")
    print(f"  {C.bold}Credential{C.reset}  {dot(bool(providers))}"
          f"{C.muted}{', '.join(providers) if providers else 'none — run Setup'}{C.reset}")
    print(f"  {C.bold}Muse{C.reset}        {dot(pathlib.Path(muse_bin()).exists())}"
          f"{C.muted}{'installed' if pathlib.Path(muse_bin()).exists() else 'missing'}{C.reset}")
    print()


def choose(options: list[str], selected: int = 0) -> int | None:
    """Arrow-key menu. Returns the index, or None on q / ctrl-c."""
    if not is_tty():
        for i, option in enumerate(options, 1):
            print(f"  {i}. {option}")
        try:
            raw = input("  select: ").strip()
        except EOFError:
            return None
        return int(raw) - 1 if raw.isdigit() and 1 <= int(raw) <= len(options) else None

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sys.stdout.write(C.hide)
    try:
        tty.setraw(fd)
        while True:
            for i, option in enumerate(options):
                if i == selected:
                    print(f"  {C.primary}❯ {C.bold}{option}{C.reset}")
                else:
                    print(f"  {C.muted}  {option}{C.reset}")
            sys.stdout.flush()
            key = sys.stdin.read(1)
            if key in ("q", "Q", "\x03"):
                return None
            if key == "\x1b":
                rest = sys.stdin.read(2)
                if rest == "[A":
                    selected = (selected - 1) % len(options)
                elif rest == "[B":
                    selected = (selected + 1) % len(options)
            elif key in ("\r", "\n"):
                return selected
            sys.stdout.write(f"\x1b[{len(options)}A")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write(C.show)
        sys.stdout.flush()


def pause() -> None:
    try:
        input(f"\n{C.muted}  press Enter to continue{C.reset}")
    except EOFError:
        pass


def interactive() -> int:
    actions = ["Set up / change key", "Toggle route", "Test route (doctor)",
               "Repair connection (heal)", "Load config URL", "Refresh", "Quit"]
    while True:
        print(C.clear, end="")
        header()
        index = choose(actions)
        if index is None or actions[index] == "Quit":
            return 0
        choice = actions[index]
        print()
        if choice == "Set up / change key":
            rc = cmd_setup()
        elif choice == "Toggle route":
            rc = cmd_off() if active_proxy() else cmd_on()
        elif choice == "Test route (doctor)":
            rc = cmd_doctor(True)
        elif choice == "Repair connection (heal)":
            rc = cmd_heal()
        elif choice == "Load config URL":
            url = input("  Config URL: ").strip()
            rc = cmd_config(url) if url else 1
        else:
            rc = 0
        if rc != 0:
            print(f"  {C.error}✗ failed{C.reset}")
        pause()


def main() -> int:
    args = sys.argv[1:]
    if not args and is_tty():
        return interactive()
    command = args[0] if args else "status"
    if command == "status":
        return cmd_status()
    if command == "on":
        return cmd_on()
    if command == "off":
        return cmd_off()
    if command == "heal":
        return cmd_heal()
    if command == "setup":
        return cmd_setup()
    if command == "config":
        if len(args) < 2:
            print("usage: pantheon config <https-url>", file=sys.stderr)
            return 1
        return cmd_config(args[1])
    if command == "doctor":
        return cmd_doctor("--heal" in args[1:])
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
